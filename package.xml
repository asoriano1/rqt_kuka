<package format="2">
  <name>rqt_kuka_plugin</name>
  <version>0.1.0</version>
  <description>Plugin RQT para control de robot KUKA</description>
  <maintainer email="tu@correo.com">Tu Nombre</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>qt_gui</build_depend>
  <build_depend>qt_gui_cpp</build_depend>
  <build_depend>python_qt_binding</build_depend>
  <build_export_depend>qt_gui</build_export_depend>
  <exec_depend>qt_gui</exec_depend>
  <exec_depend>qt_gui_cpp</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>

  <export>
    <qt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>

